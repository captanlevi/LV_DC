{
  "manifest_version": 3,
  "name": "YT Video Watcher",
  "version": "2.0",
  "description": "Observe live video playback",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.facebook.com/*",
        "*://m.facebook.com/*",
        "*://web.facebook.com/*",
        "*://*.cnn.com/*",
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*",
        "*://www.instagram.com/*",
        "*://*.instagram.com/*",
        "*://www.twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://live.bilibili.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.twitch.tv/*"
      ],
      "js": [
        "page_stats.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
